option(
  'embree',
  type : 'feature',
  value : 'enabled',
  description : 'Compile features and examples using Embree')

option(
  'python',
  type : 'feature',
  value : 'enabled',
  description : 'Build butterfly\'s Python wrapper')

option(
  'mfem',
  type : 'feature',
  value : 'disabled',
  description : 'Compile features and examples using MFEM')

option('fmm2d', type : 'feature', value : 'disabled',
       description : 'Enable 2D FMM features (needs libfmm2d via pkg-config)')
option('argtable3', type : 'feature', value : 'disabled',
       description : 'Enable CLI examples that use argtable3')
option('examples', type : 'feature', value : 'disabled',
       description : 'Build C examples (may require extra libs)')
option('tests', type : 'feature', value : 'disabled',
       description : 'Build C tests (requires cmocka)')
option(
  'primme',
  type : 'feature',
  value : 'disabled',
  description : 'Enable PRIMME (primme_svds) in butterfly'
)
option(
  'primme_root',
  type : 'string',
  value : '',
  description : 'Root directory of PRIMME source/build tree (with include/ and lib/)'
)
